     if (device_data->handle < 0) {
         return SDL_SetError("sceVideoOutOpen: %s", strerror(errno));
     }
+    /* Buffer strategy: a single 64M block (reference layout, vbuf[1] =
+     * vaddr+32M) first — the app context can usually allocate it and it
+     * matches the known-good driver exactly. Fall back to two 16M
+     * blocks for the WebKit payload context where 64M fails. */
     device_data->memsize = 0x4000000;
+    device_data->paddr2 = 0;
     if (sceKernelAllocateMainDirectMemory(device_data->memsize, 0x20000, 3,
-                                          &device_data->paddr)) {
-        return SDL_SetError("sceKernelAllocateMainDirectMemory: %s",
-                            strerror(errno));
-    }
-
-    if (sceKernelMapDirectMemory(&vaddr, device_data->memsize, 0x33, 0,
+                                          &device_data->paddr) ||
+        sceKernelMapDirectMemory(&vaddr, device_data->memsize, 0x33, 0,
                                  device_data->paddr, 0x20000)) {
-        return SDL_SetError("sceKernelMapDirectMemory: %s", strerror(errno));
+        device_data->memsize = 0x1000000;
+        device_data->paddr = 0;
+        if (sceKernelAllocateMainDirectMemory(device_data->memsize, 0x20000, 3,
+                                              &device_data->paddr) ||
+            sceKernelAllocateMainDirectMemory(device_data->memsize, 0x20000, 3,
