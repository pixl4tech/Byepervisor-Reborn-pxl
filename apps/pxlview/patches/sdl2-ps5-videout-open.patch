+/* Open a VideoOut session: display 0 first (we own it when running
+ * inside a formally launched app), fall back to display 2 (plain
+ * payload context, VSH holds display 0). */
+static int PS5_VideoOutOpenAny(void)
+{
+    int h = sceVideoOutOpen(0xff, 0, 0, NULL);
+    if (h >= 0) {
+        return h;
+    }
+    return sceVideoOutOpen(0xff, 2, 0, NULL);
+}
+
 static int PS5_UpdateWindowFramebuffer(_THIS, SDL_Window *window,
                                        const SDL_Rect *rects, int numrects)
 {
@@ -145,7 +157,10 @@ static int PS5_SetDisplayMode(_THIS, SDL_VideoDisplay * display,
     if(device_data->handle >= 0) {
         sceVideoOutClose(device_data->handle);
     }
-    device_data->handle = sceVideoOutOpen(0xff, 0, 0, NULL);
+    device_data->handle = PS5_VideoOutOpenAny();
+    if(device_data->handle < 0) {
+        return SDL_SetError("sceVideoOutOpen: %s", strerror(errno));
+    }
 
     if (sceKernelCreateEqueue(&device_data->evt_queue, "flip queue")) {
         return SDL_SetError("sceKernelCreateEqueue: %s", strerror(errno));
@@ -192,6 +207,7 @@ static int PS5_VideoInit(_THIS)
