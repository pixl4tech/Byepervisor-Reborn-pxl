# ---------------------------------------------------------------------------
# Byepervisor-pxl build
#
#   make                 -> build/debug/byepv-pxl-v$(VERSION).elf
#   make release         -> build/release/...   (no USB log file)
#   make standalone      -> build/standalone/... (no USB, non-blocking stdout,
#                            runs to completion with no host listener)
#   make all-variants    -> all three
#   make test            -> python unit tests (tests/)
#   make deploy          -> send debug ELF to the console (PS5_HOST/PS5_PORT)
#
# SDK: scripts/bootstrap_sdk.sh, then export PS5_PAYLOAD_SDK=$PWD/sdk/ps5-payload-sdk
# ---------------------------------------------------------------------------

PS5_HOST ?= ps5
PS5_PORT ?= 9021

VERSION ?= 0.1.0
VARIANT ?= debug    # debug | release | standalone

ifdef PS5_PAYLOAD_SDK
    include $(PS5_PAYLOAD_SDK)/toolchain/prospero.mk
else
    $(error PS5_PAYLOAD_SDK is undefined - run scripts/bootstrap_sdk.sh)
endif

BUILD_DIR := build/$(VARIANT)
ELF       := $(BUILD_DIR)/byepv-pxl-v$(VERSION).elf
LATEST    := $(BUILD_DIR)/byepv-pxl-latest.elf
VERSION_H := include/version.h

PAYLOAD_DIR := break_hv_payload
PAYLOAD_HDR := $(PAYLOAD_DIR)/break_hv.h

# -O0 in every variant: the resume hook does noinline register saves and
# inline-asm single-steps; the outer payload must not be optimized across
# those boundaries (validated on hardware).
CFLAGS := -Wall -Werror -Wno-unused-function -O0 -g -I./include

# Variant switches
CFLAGS += -DPXEL_VARIANT=\"$(VARIANT)\"
ifeq ($(VARIANT),release)
    CFLAGS += -DPXEL_NO_USB
endif
ifeq ($(VARIANT),standalone)
    CFLAGS += -DPXEL_NO_USB -DPXEL_STANDALONE
endif

all: $(ELF)

$(VERSION_H): Makefile
	@mkdir -p $(dir $@)
	@echo "/* generated by the Makefile - do not edit */" > $@
	@echo "#define PXEL_VERSION \"$(VERSION)\"" >> $@

$(PAYLOAD_HDR): $(PAYLOAD_DIR)/break_hv.c $(PAYLOAD_DIR)/entry.S $(PAYLOAD_DIR)/link.ld
	sh $(PAYLOAD_DIR)/build.sh

$(ELF): $(PAYLOAD_HDR) $(VERSION_H) main.c kdlsym.c khook.c h1160.c elog.c paging.c util.c
	@mkdir -p $(BUILD_DIR)
	$(CC) $(CFLAGS) -o $@ $(filter %.c,$^)
	@ln -sf $(notdir $(ELF)) $(LATEST)
	@echo "built: $@ (variant=$(VARIANT) version=$(VERSION))"

release:
	$(MAKE) VARIANT=release

standalone:
	$(MAKE) VARIANT=standalone

all-variants:
	$(MAKE) VARIANT=debug
	$(MAKE) VARIANT=release
	$(MAKE) VARIANT=standalone

clean:
	rm -rf build
	rm -f $(VERSION_H)
	rm -f $(PAYLOAD_DIR)/break_hv.h $(PAYLOAD_DIR)/break_hv.bin $(PAYLOAD_DIR)/break_hv.elf $(PAYLOAD_DIR)/*.o

test:
	python3 -m unittest discover -s tests -v

deploy: all
	$(PS5_DEPLOY) -h $(PS5_HOST) -p $(PS5_PORT) $(ELF)

debug: all
	gdb-multiarch \
	-ex "set architecture i386:x86-64" \
	-ex "target extended-remote $(PS5_HOST):2159" \
	-ex "file $(ELF)" \
	-ex "remote put $(ELF) /data/byepv-pxl.elf" \
	-ex "set remote exec-file /data/byepv-pxl.elf" \
	-ex "start"

.PHONY: all release standalone all-variants clean test deploy debug
